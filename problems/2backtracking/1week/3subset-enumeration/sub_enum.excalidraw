      "y": 71.20002746582031,
      "width": 450.95965576171875,
      "height": 725,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 1196490985,
      "version": 121,
      "versionNonce": 2053373735,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788683085398,
      "link": null,
      "locked": false,
      "text": "void dfs(int n, vector<int> cur_ans, int start)\n{\n    //1. 检查\n    ans.push_back(cur_ans);\n    if(cur_ans.size() == n)\n    {\n        return;\n    }\n\n    for(int i =start; i <=n; ++i)\n    {\n        // 2. 判断能够递归\n        if(visited[i] == true) continue;\n\n        // 3. 使用当前元素\n        cur_ans.push_back(i);\n        visited[i] = true;    \n\n        // (1)  --> (1, 2, 3 )  (1, 3, 2)\n        // (2)  --> (2, 1, 3)   (2. 3. 1)\n        // 4. 递归搜索\n        dfs(n, cur_ans,  i+1);\n\n        // 5. 恢复\n        cur_ans.pop_back();\n        visited[i] = false;\n    }\n\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void dfs(int n, vector<int> cur_ans, int start)\n{\n    //1. 检查\n    ans.push_back(cur_ans);\n    if(cur_ans.size() == n)\n    {\n        return;\n    }\n\n    for(int i =start; i <=n; ++i)\n    {\n        // 2. 判断能够递归\n        if(visited[i] == true) continue;\n\n        // 3. 使用当前元素\n        cur_ans.push_back(i);\n        visited[i] = true;    \n\n        // (1)  --> (1, 2, 3 )  (1, 3, 2)\n        // (2)  --> (2, 1, 3)   (2. 3. 1)\n        // 4. 递归搜索\n        dfs(n, cur_ans,  i+1);\n\n        // 5. 恢复\n        cur_ans.pop_back();\n        visited[i] = false;\n    }\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
