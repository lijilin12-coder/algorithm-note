      "updated": 1787887602300,
      "link": null,
      "locked": false,
      "text": "left = dummy\nright = left->next\n\ncnt = 0;\nwhile(right)\n    cnt ++;\n    if (cnt % k == 0)\n    {\n        right = right->next;\n        p = left->next\n        ListNode* last == left->next;\n        left->next = nullptr\n        while(p!=right)\n        {\n            ListNode* q = p->next\n            p->next = left->next\n            left->next = p\n            p = q\n        }\n        last->next = right\n        left = last\n    }\n    else\n    {\n        right = right->next;\n    }",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "left = dummy\nright = left->next\n\ncnt = 0;\nwhile(right)\n    cnt ++;\n    if (cnt % k == 0)\n    {\n        right = right->next;\n        p = left->next\n        ListNode* last == left->next;\n        left->next = nullptr\n        while(p!=right)\n        {\n            ListNode* q = p->next\n            p->next = left->next\n            left->next = p\n            p = q\n        }\n        last->next = right\n        left = last\n    }\n    else\n    {\n        right = right->next;\n    }",
      "autoResize": true,
      "lineHeight": 1.25
    },
