{
    // 蓝桥杯刷题本地平台 - 调试配置
    //
    // 使用方法:
    //   1. 打开你要调试的题目的 solution.cpp，确保它是当前激活的编辑器标签页
    //      （下方 "program"/"args"/"customLaunchSetupCommands" 用
    //      ${fileDirname} 自动取该文件所在的题目文件夹，无需手动修改路径）
    //   2. 如需调试非默认的测试用例（默认是 tests/1.in）：
    //      - gdb 配置：手动把 "args" 中的 "tests/1.in" 改成目标用例文件名
    //      - lldb 配置：手动把 "customLaunchSetupCommands" 里命令中的
    //        "tests/1.in" 改成目标用例文件名
    //   3. 在代码中设置断点，按 F5 启动调试
    //
    // 已知限制：
    //   - 启动调试时必须保证当前激活的编辑器标签页就是目标题目的 solution.cpp，
    //     否则 ${fileDirname} 会指向错误的题目文件夹（编译/调试会失败或对应到
    //     另一道题目）。
    //   - lldb-mi 不支持 gdb 那种 "args": ["<", "文件"] 的 stdin 重定向语法（会
    //     被当成普通参数传给程序而非重定向 stdin，导致程序卡住等待真实终端输
    //     入）。macOS 配置改用 lldb 的 "target.input-path" 设置重定向，未在真实
    //     macOS 环境验证，如遇问题请改用命令行 `scripts/debug.sh` 调试。
    //
    // 已提供三组配置：
    //   - "Debug (Linux/WSL - gdb)"：C++ 题目，在 WSL/Linux 下使用 gdb
    //   - "Debug (macOS - lldb)"：C++ 题目，在 macOS 下使用 lldb
    //   - "Debug Python (current problem)"：Python 题目（solution.py），使用
    //     debugpy。用法同上：打开题目的 solution.py 作为当前激活标签页，按 F5。
    //
    //     实现说明：debugpy 的 "launch" 模式不支持 cppdbg 那种 shell 风格的
    //     stdin 重定向参数，所以这里改用 "attach" 模式——preLaunchTask
    //     （scripts/debugpy_listen.sh）先在后台以 --wait-for-client 启动目标
    //     脚本并把 tests/1.in 重定向为其 stdin，端口就绪后本配置再 attach 上
    //     去。对使用者而言仍是一次 F5，只是内部多了一次自动完成的握手。
    //
    //     依赖：需要先在运行环境里执行一次 `pip install debugpy`（VS Code
    //     Python 扩展自带的 debugpy 只服务于扩展自己发起的 launch 调试，不能
    //     被这里的命令行监听方式复用）。
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (Linux/WSL - gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/solution_debug",
            "args": ["<", "${fileDirname}/tests/1.in"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "编译当前题目（调试符号）",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug (macOS - lldb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/solution_debug",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "编译当前题目（调试符号）",
            // lldb-mi 不支持 gdb 那种 "args": ["<", "文件"] 的 stdin 重定向语法
            // （会被当成普通命令行参数传给程序，而不是重定向 stdin，导致程序卡在
            // 等待真实终端输入）。这里改用 lldb 原生的 "target.input-path" 设置
            // 重定向 stdin。
            //
            // 注意：不要改用 "customLaunchSetupCommands" 来做这件事——它会完全
            // 替换默认的启动流程，在 Apple Silicon (ARM) Mac 上会触发 cpptools
            // 的已知 bug，导致 "Specified argument was out of the range of
            // valid values. Parameter name: arch" 报错，直接无法进入调试。
            // 参考: https://github.com/microsoft/vscode-cpptools/issues/7488
            "setupCommands": [
                {
                    "text": "-interpreter-exec console \"settings set target.input-path ${fileDirname}/tests/1.in\"",
                    "description": "以 tests/1.in 重定向 stdin",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "Debug Python (current problem)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "preLaunchTask": "启动 Python 调试目标（debugpy 监听）",
            "justMyCode": true
        }
    ]
}
